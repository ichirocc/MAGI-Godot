; Engine configuration file.
; MAGI ShiftOptimizer Godot UI レイヤー（Compose UIの置き換え候補、docs/godot-ui-migration.md 参照）

config_version=5

[application]

config/name="MAGI ShiftOptimizer UI"
run/main_scene="res://scenes/Home.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://assets/icon.svg"

[debug]

; 実機の logcat が得られない前提で、Godot のエラー出力を user://logs/（Android では filesDir）に残す。
; 次回起動時に MagiGodotActivity の診断画面が末尾を表示する（MagiStartupGuard）。
file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
; 端末の回転に追従（3.551.0 ユーザー決定。安全領域と拡大率は base_screen.gd / nav.gd が実行時に合わせる）
window/handheld/orientation="sensor"

[rendering]

renderer/rendering_method="mobile"

[autoload]

MagiApi="*res://scripts/magi_api.gd"
Nav="*res://scripts/nav.gd"
