<!-- [Godot移行] magiGodot=true のときだけ debug/release の build-type manifest として合流する
     （app/build.gradle.kts）。build-type manifest は main より高優先なので、ここから main の
     MainActivity(Compose) のランチャー登録を外し、MagiGodotActivity を起動入口に付け替える。
     既定ビルド（magiGodot 未指定）はこのファイルを読まない＝Compose 版の Manifest は無変更。
     configChanges は Godot 公式テンプレートに合わせ、回転・文字サイズ等で Activity を再生成せず
     エンジンを生かしたままにする。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".godot.MagiGodotActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode|fontScale"
            android:theme="@style/Theme.Magi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
